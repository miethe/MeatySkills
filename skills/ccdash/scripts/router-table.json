{
  "$schema_version": 2,
  "skill_version": "2.0",
  "app_version": "2026-04-26",
  "updated": "2026-04-26",
  "description": "Intent→transport routing table for the ccdash skill. Covers both MCP tools and CLI commands. Update this file and CHANGELOG.md whenever the query surface changes.",
  "intents": [
    {
      "id": "project-status",
      "intent_pattern": "project status | how is the project | what's the state of this project | overall health | project summary",
      "command": "ccdash status project",
      "default_output": "json",
      "provenance_fields": ["project_id", "generated_at", "feature_ids", "active_session_ids"],
      "recipe": "recipes/project-triage.md",
      "transport": ["mcp", "cli"],
      "mcp_tool": "ccdash_project_status",
      "flags": ["--timeout N", "--json", "--md", "--output {human|json|markdown}", "--no-cache"]
    },
    {
      "id": "doctor",
      "intent_pattern": "diagnose | doctor | connectivity check | why can't I reach | server unreachable | auth broken",
      "command": "ccdash doctor",
      "default_output": "human",
      "provenance_fields": ["target", "url", "reachable", "authenticated"],
      "recipe": "recipes/unreachable-server.md",
      "transport": ["cli"],
      "flags": ["--timeout N", "--json", "--md", "--output {human|json|markdown}"]
    },
    {
